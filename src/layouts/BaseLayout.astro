---
import SEO from "../components/SEO.astro";

const {
  title = "Safar's Dev Blog",
  description = "",
  image = "/og-default.png",
  article = false,
  publishTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      publishTime={publishTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      noindex={noindex}
    />
  </head>
  <body>
    <slot />
  </body>
</html>